{
  "name": "shree-rbsk-referral-system",
  "version": "1.0.0",
  "description": "Shree RBSK Referral Management Full-Stack Node.js & React Application",
  "type": "module",
  "main": "api/index.js",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server:dev\" \"npm run client\"",
    "start": "npm run start --prefix server",
    "server": "npm run start --prefix server",
    "server:dev": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "client:build": "npm run build --prefix client",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client"
  },
  "dependencies": {
    "concurrently": "^9.1.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
